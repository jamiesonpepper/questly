# Copy to .env and edit before running: cp .env.example .env

# Host port the app is served on -> http://localhost:37000
PORT=37000

# Cookie signing key. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-change-me-to-a-long-random-string

# Mongo database name
MONGO_DB=questly

# Where MongoDB lives. Leave this commented out to use the mongo container
# that ships with this compose file.
#
# To use a MongoDB container you run yourself, uncomment one of these and
# start only the web service:  docker compose up -d --no-deps web
#
#   same custom docker network, reachable by container name:
# MONGO_URI=mongodb://my-mongodb:27017/
#
#   reachable on the host's IP, with the Mongo port published:
# MONGO_URI=mongodb://192.168.1.50:27017/
#
#   if your MongoDB has authentication enabled:
# MONGO_URI=mongodb://questly:the-password@my-mongodb:27017/?authSource=admin

# Timezone used for dates, daily quest resets and weekly resets
TZ=Europe/London
